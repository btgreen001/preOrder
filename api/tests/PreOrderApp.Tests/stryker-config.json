{
  "stryker-config": {

    "reporters": [
      "html",
      "progress"
    ],

    "mutate": [
      "!**/bin/**",
      "!**/obj/**",
      "!**/Migrations/**",
      "!**/Generated/**",
      "!**/Program.cs",
      "!**/Startup.cs",
      "!**/*Service.cs",
      "!**/*Client.cs",
      "!**/*Repository.cs",
      "!**/*Options.cs",
      "!**/*Settings.cs",
      "!**/Models/LicenseModels.cs",
      "!**/Models/LicenseUtils.cs",
      "!**/Services/FractionUtility.cs",
      "!**/Services/UnitConversionService.cs"

    ],

    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    }
  }
}
