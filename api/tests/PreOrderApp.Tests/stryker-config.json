{
  "stryker-config": {

    "reporters": [
      "html",
      "progress"
    ],

    "mutate": [
      "!**/Data/**",
      "!**/*DbContext.cs",
      "!**/*Context.cs",
      "!**/bin/**",
      "!**/obj/**",
      "!**/Migrations/**",
      "!**/Generated/**",
      "!**/Program.cs",
      "!**/Startup.cs",
      "!**/*Client.cs",
      "!**/*Repository.cs",
      "!**/*Options.cs",
      "!**/*Settings.cs",
      "!**/Controllers/**",
      "!**/DTOs/**",
      "!**/Migrations_old/**",
      "!**/Filters/**",
      "!**/Middleware/**",
      "!**/Models/**",
      "!**/Services/FractionUtility.cs",
      "!**/Services/UnitConversionService.cs"

    ],

    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    }
  }
}
