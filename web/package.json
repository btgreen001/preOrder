{
  "name": "angular-client-new",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "dotenv -e ../.env -e ../.env.local -- ng serve --configuration=https",
    "start:http": "dotenv -e ../.env -e ../.env.local -- ng serve",
    "start:https": "dotenv -e ../.env -e ../.env.local -- ng serve --configuration=https",
    "build": "ng build",
    "build:prod": "dotenv -e ../.env -e ../.env.local -- ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "ng test",
    "test:ci:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage --include src/core/auth.guard.spec.ts",
    "coverage:check:frontend": "node scripts/check-lcov.mjs coverage/angular-client-new/core/auth.guard.ts.html 80 frontend",
    "lint": "ng lint",
    "e2e": "cypress run --browser electron",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@stripe/stripe-js": "^9.7.0",
    "jspdf": "^4.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/language-service": "^22.0.0",
    "@cypress/angular": "^4.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.3.0",
    "baseline-browser-mapping": "^2.10.0",
    "cypress": "^15.4.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.35.0",
    "http-server": "^14.1.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "overrides": {
    "qs": "6.15.2",
    "systeminformation": ">=5.31.6",
    "tmp": "0.2.6",
    "hono": "4.12.21"
  }
}
